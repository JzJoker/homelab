# Environment template for caddy/docker-compose.yml
# Copy to .env and fill in:  cp .env.example .env   (real .env is gitignored)

# The domain Caddy serves, used by {$CADDY_DOMAIN} in the Caddyfile.
# Your Tailscale MagicDNS hostname, e.g. <host>.<tailnet>.ts.net
CADDY_DOMAIN=your-host.your-tailnet.ts.net
