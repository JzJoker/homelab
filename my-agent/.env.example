# my-agent secrets. Copy to .env and fill in. .env is gitignored.
# Blank optional keys = that feature is skipped.

# --- Required ---------------------------------------------------------------
# Moonshot (Kimi) API key — billed against your Moonshot account credits.
# From platform.moonshot.ai (global) or platform.moonshot.cn (CN).
MOONSHOT_API_KEY=
# Optional: override the Moonshot base URL. Default https://api.moonshot.ai/v1
# Use https://api.moonshot.cn/v1 if your credits are on the CN platform.
MOONSHOT_BASE_URL=
# Telegram bot token from @BotFather.
TELEGRAM_TOKEN=
# Your Telegram chat id (single-user gate) from @userinfobot.
TELEGRAM_CHAT_ID=

# --- Web search (Tavily) ----------------------------------------------------
TAVILY_API_KEY=

# --- Google: Gmail / Calendar / Sheets (Composio) ---------------------------
# Both required; the Google account is connected under this Composio user.
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=

# --- Tracing (Laminar) ------------------------------------------------------
LMNR_PROJECT_API_KEY=

# --- Bambu A1 printer telemetry (MQTT) for check_print ----------------------
# LAN IP, Access Code, and serial (auto-readable from the printer's TLS cert CN).
PRINTER_ADDRESS=192.168.1.100
PRINTER_ACCESS_CODE=00000000
PRINTER_SERIAL=00M00A000000000

# --- Voice /ask endpoint (phone assistant) ----------------------------------
# Bearer token the iOS Shortcut sends. Leave blank to disable the endpoint.
# Generate with: openssl rand -hex 32
ASK_TOKEN=
